# Supabase (safe to expose — anon key is public by design, guarded by RLS)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service-role key — SERVER ONLY. Powers /api/admin/* (account creation,
# resets, disable). NEVER prefix with NEXT_PUBLIC_, never commit a real value.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic — server-only, NEVER prefix with NEXT_PUBLIC_
ANTHROPIC_API_KEY=sk-ant-...

# Set to 1 to force the deterministic AI fallback (demo insurance)
AI_DISABLED=

# Set to 1 for the offline fixture-backed demo build (fallback ladder L3)
NEXT_PUBLIC_DEMO_MODE=
